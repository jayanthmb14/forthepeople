{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "devCommand": "next dev",
  "installCommand": "npm ci",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://forthepeople.in"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "X-Creator", "value": "Jayanth M B" },
        { "key": "X-Project-ID", "value": "FTP-JMB-2026-IN" },
        { "key": "X-License", "value": "MIT" }
      ]
    }
  ],
  "rewrites": [],
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/scrape-news",
      "schedule": "10 */4 * * *"
    },
    {
      "path": "/api/cron/translate-content",
      "schedule": "20 */3 * * *"
    },
    {
      "path": "/api/cron/scrape-crops",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/scrape-weather",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/scrape-dams",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/scrape-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/generate-insights",
      "schedule": "0 0,12 * * *"
    },
    {
      "path": "/api/cron/news-intelligence",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/scrape-budget",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/generate-citizen-tips",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/cron/update-exams",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/platform-report",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/health-score",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/verify-data",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/scrape-courts",
      "schedule": "40 1,13 * * *"
    },
    {
      "path": "/api/cron/scrape-jjm",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/scrape-schools",
      "schedule": "40 4 * * 2"
    },
    {
      "path": "/api/cron/scrape-mgnrega",
      "schedule": "50 4 * * *"
    },
    {
      "path": "/api/cron/scrape-tenders",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/cron/dedupe-data",
      "schedule": "15 7 * * *"
    }
  ]
}
