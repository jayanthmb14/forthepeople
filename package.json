{
  "name": "forthepeople-in",
  "version": "1.0.0",
  "description": "India's Citizen Transparency Platform — Free, real-time district-level government data dashboards",
  "author": {
    "name": "Jayanth M B",
    "url": "https://forthepeople.in"
  },
  "license": "MIT",
  "homepage": "https://forthepeople.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/jayanthmb14/forthepeople.git"
  },
  "keywords": [
    "india",
    "civic-tech",
    "transparency",
    "government-data",
    "district-dashboard",
    "open-data",
    "ndsap",
    "karnataka",
    "nextjs",
    "prisma",
    "citizen-platform"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:tenders": "bash scripts/lint-tender-copy.sh",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npx tsx prisma/seed.ts",
    "scraper": "npx tsx src/scraper/scheduler.ts",
    "scraper:dev": "npx tsx --watch src/scraper/scheduler.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
