    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/bcryptjs": "^2.4.6",
    "@upstash/redis": "^1.38.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
