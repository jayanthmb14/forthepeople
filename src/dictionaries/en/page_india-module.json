  "tigers": {
    "camera": {
      "title": "How the camera-trap count works",
      "body": "NTCA's All India Tiger Estimation places camera traps across tiger habitats in the country. Each tiger is identified by its stripe pattern. The estimate combines tigers seen on camera with density estimates from sign surveys in areas without cameras. The 2022 round used cameras at 32,588 locations in 20 tiger states."
    },
    "meaning": {
      "title": "What the tiger number means",
      "body": "The headline figure, 3,682, is the average estimate of the All India Tiger Estimation 2022. NTCA publishes a range around it, from 3,167 to 3,925; 3,167 is the minimum number of tigers actually photographed by camera traps. The methodology PDF explains the full range."
    },
    "gaps": {
      "title": "Uncertainty and known gaps",
      "body": "Areas with few cameras carry more uncertainty. The Northeast and parts of central India are sampled less densely. Because the count happens every four years, the change between two counts reflects both real change in tiger numbers and better counting methods."
    },
    "report": {
      "title": "The full report",
      "body": "NTCA, Status of Tigers in India 2022: the official report (PDF)."
    }
  }
