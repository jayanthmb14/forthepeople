  "tigers": {
    "camera": {
      "title": "ಕ್ಯಾಮೆರಾ ಬಲೆ ಗಣತಿ ಹೇಗೆ ನಡೆಯುತ್ತದೆ",
      "body": "NTCAಯ ಅಖಿಲ ಭಾರತ ಹುಲಿ ಅಂದಾಜು ದೇಶದಾದ್ಯಂತ ಹುಲಿಗಳ ಆವಾಸಸ್ಥಾನಗಳಲ್ಲಿ ಕ್ಯಾಮೆರಾ ಬಲೆಗಳನ್ನು ಇರಿಸುತ್ತದೆ. ಪ್ರತಿ ಹುಲಿಯನ್ನು ಅದರ ಪಟ್ಟೆಗಳ ವಿನ್ಯಾಸದಿಂದ ಗುರುತಿಸಲಾಗುತ್ತದೆ. ಕ್ಯಾಮೆರಾದಲ್ಲಿ ಕಂಡ ಹುಲಿಗಳು ಮತ್ತು ಕ್ಯಾಮೆರಾ ಇಲ್ಲದ ಪ್ರದೇಶಗಳಲ್ಲಿ ಹೆಜ್ಜೆಗುರುತು ಸಮೀಕ್ಷೆಯಿಂದ ಪಡೆದ ಸಾಂದ್ರತೆಯ ಅಂದಾಜನ್ನು ಸೇರಿಸಿ ಒಟ್ಟು ಅಂದಾಜು ಮಾಡಲಾಗುತ್ತದೆ. 2022ರ ಸುತ್ತಿನಲ್ಲಿ 20 ಹುಲಿ ರಾಜ್ಯಗಳ 32,588 ಸ್ಥಳಗಳಲ್ಲಿ ಕ್ಯಾಮೆರಾಗಳನ್ನು ಬಳಸಲಾಯಿತು."
    },
    "meaning": {
      "title": "ಹುಲಿಗಳ ಸಂಖ್ಯೆಯ ಅರ್ಥ",
      "body": "ಮುಖ್ಯ ಅಂಕಿ 3,682, ಅಖಿಲ ಭಾರತ ಹುಲಿ ಅಂದಾಜು 2022ರ ಸರಾಸರಿ ಅಂದಾಜು. NTCA ಇದರ ಸುತ್ತ 3,167ರಿಂದ 3,925ರವರೆಗಿನ ಶ್ರೇಣಿಯನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ; 3,167 ಎಂದರೆ ಕ್ಯಾಮೆರಾ ಬಲೆಗಳಲ್ಲಿ ನಿಜವಾಗಿ ಸೆರೆಯಾದ ಕನಿಷ್ಠ ಹುಲಿಗಳ ಸಂಖ್ಯೆ. ಪೂರ್ಣ ಶ್ರೇಣಿಯನ್ನು ವಿಧಾನದ ಪಿಡಿಎಫ್ ವಿವರಿಸುತ್ತದೆ."
    },
