# ═══════════════════════════════════════════════════════════════
# ForThePeople.in — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values:
#     cp .env.example .env.local
# This file is the ONLY list of environment variables the app reads.
# It was regenerated on 2026-09-27 from a grep of `process.env.*` across
# src/, scripts/ and prisma/. If you add a new process.env read in code,
# add its NAME here in the same commit.
# NEVER commit .env.local or any file with actual secrets.
# ═══════════════════════════════════════════════════════════════

# ═══ Database (Neon PostgreSQL) — REQUIRED ═══
# Prisma connects through @prisma/adapter-pg. The app throws at startup without it.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ═══ Redis (Upstash — REST API, required for Vercel serverless) ═══
# Uses @upstash/redis (NOT ioredis). Both values from upstash.com → your DB → REST API.
# Optional locally (cache disabled with a warning), REQUIRED in prod: admin
# sessions, rate limits and cron locks live here.
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=your-upstash-rest-token

# ═══ AI providers ═══
# All AI calls go through src/lib/ai-provider.ts (callAI / callAIJSON).
# OpenRouter is the default gateway (free-tier models for news classification).
OPENROUTER_API_KEY=your-openrouter-key
# Optional direct Anthropic access (fact-check + paid fallback). Leave blank to disable.
ANTHROPIC_API_KEY=
# Optional: point the Anthropic SDK at a proxy / gateway. Leave blank for the default.
ANTHROPIC_BASE_URL=
# Which provider callAI() prefers: "openrouter" (default) or "anthropic".
FTP_AI_PROVIDER=openrouter
# "1" allows a PAID model to be used when every free model fails. Default off (cost control).
AI_PAID_FALLBACK=0

# ═══ External data APIs ═══
DATA_GOV_API_KEY=your-data-gov-key
OPENWEATHER_API_KEY=your-openweather-key

# ═══ Payments (Razorpay) ═══
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Same key id, exposed to the browser for the checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# Webhook signing secret from Razorpay dashboard → Webhooks. Rotating it needs
# the atomic procedure in the ops runbook (a mismatch drops every payment event).
RAZORPAY_WEBHOOK_SECRET=
# Optional pre-created Razorpay plan ids for the monthly tiers. When blank, a
# plan is created on the fly per subscription.
RAZORPAY_PLAN_DISTRICT=
RAZORPAY_PLAN_STATE=
RAZORPAY_PLAN_PATRON=
RAZORPAY_PLAN_FOUNDER=

# ═══ Admin & security ═══
# Admin login password (compared server-side). Use a long random string.
ADMIN_PASSWORD=change-this-to-a-strong-password
# Signing secret for admin session cookies (signed, revocable, 8h sessions).
# REQUIRED — src/lib/admin-auth.ts throws at module load without it, and
# `next build` imports that module, so set it in Vercel AND CI. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=random-hex-for-admin-session-signing
# AES key for encrypting stored API keys / TOTP secrets at rest (32+ random chars).
ENCRYPTION_SECRET=32-char-random-string-for-aes256
# Bearer secret Vercel Cron sends to /api/cron/* (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=random-string-for-cron-auth
# Bearer secret for the one-shot /api/admin/seed-tenders endpoint (also accepted
# by requireAdmin as an ops credential). openssl rand -hex 32
SEED_SECRET=random-hex-for-tenders-seed-bearer-auth
# Salt for hashing visitor IPs before they are used as rate-limit keys. Raw IPs
# are never stored. Rotating it resets every per-IP window. openssl rand -hex 32
VOTE_IP_SALT=
# Optional comma-separated IP allowlist for /admin (leave empty to disable).
ADMIN_ALLOWED_IPS=

# ═══ Email (Resend) — admin alerts + recovery ═══
RESEND_API_KEY=re_xxxxxxxxxxxxx
ADMIN_EMAIL=your-email@example.com
# Optional admin recovery contacts shown on /admin/recover.
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PHONE=

# ═══ Analytics (Plausible — no cookies, DPDP-friendly) ═══
# Tracking script loads only when this is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=forthepeople.in
# Stats API key (admin Traffic tab). Different from the tracking script above.
# plausible.io → Settings → API Keys
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=forthepeople.in

# ═══ Error monitoring (Sentry) ═══
NEXT_PUBLIC_SENTRY_DSN=
# Build-time token for source-map upload (next.config.ts).
SENTRY_AUTH_TOKEN=
# Read-only API token for pulling unresolved errors into the admin panel.
# DIFFERENT from SENTRY_AUTH_TOKEN. Scopes: event:read, project:read
SENTRY_API_TOKEN=
SENTRY_ORG=forthepeoplein
SENTRY_PROJECT=javascript-nextjs

# ═══ Site ═══
NEXT_PUBLIC_SITE_URL=https://forthepeople.in
# "1" switches on election-period UI (Model Code of Conduct notices).
NEXT_PUBLIC_ELECTION_MODE=0

# ═══ Local development only (ignored in production) ═══
# "1" renders fake supporters on the contributors wall. Double-gated with
# NODE_ENV=development, so it can never affect prod.
FTP_MOCK_CONTRIBUTORS=0
FTP_MOCK_POOL_SIZE=40
# Set to "1" only when building the Docker image (enables Next standalone output).
DOCKER_BUILD=
